# Copy this file to .env and fill in real values.
# .env is gitignored - never commit real secrets.

# Microsoft Graph / Entra ID app registration (Phase 8)
TENANT_ID=
CLIENT_ID=
CLIENT_SECRET=

# SharePoint site + list IDs used as the onboarding/offboarding front door
SHAREPOINT_SITE_ID=
ONBOARDING_LIST_ID=
OFFBOARDING_LIST_ID=

# SQLite database path
DATABASE_URL=sqlite:///./deviceidentityops.db

# Safety default: device deployment/actions stay simulated unless this is
# explicitly set to false in a controlled environment.
DRY_RUN=true
